# The article API to talk to. For the local demo this is the wrangler dev server.
ARTICLE_API_URL=http://localhost:8787

# dev    -> sends no credentials. Only works against a local API running with
#           ENVIRONMENT=development (or with wrangler's [access.dev] identity).
# access -> sends Cloudflare Access service-token headers (needs the two vars below).
MCP_AUTH_MODE=dev

# Only needed when MCP_AUTH_MODE=access:
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Inline-image limits (optional; these are the defaults):
# MAX_INLINE_IMAGES=5
# MAX_IMAGE_BYTES=2000000
